# When using docker compose: host=127.0.0.1, port=3307, user=cams, password=camspass
# For local MySQL installed directly: change port, user, and password.
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cams
DB_PASSWORD=camspass
DB_NAME=cams
# Set strong passwords BEFORE running npm run seed; never commit api/.env
SEED_ADMIN_EMAIL=admin@stha.demo
SEED_ADMIN_PASSWORD=
SEED_MANAGEMENT_EMAIL=management@stha.demo
SEED_MANAGEMENT_PASSWORD=
